{
  "bundle": {
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "fileAssociations": [
      {
        "ext": ["ifcpp"],
        "name": "IFCPP project",
        "mimeType": "application/x-ifcpp",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "depends": ["shared-mime-info", "desktop-file-utils"],
        "desktopTemplate": "linux/pile-plan-studio.desktop",
        "files": {
          "/usr/share/mime/packages/pile-plan-studio.xml": "linux/pile-plan-studio.xml"
        }
      }
    }
  }
}

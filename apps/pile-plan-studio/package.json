{
  "name": "pile-plan-studio",
  "private": true,
  "version": "0.4.3",
  "release": {
    "channel": "alpha",
    "date": null
  },
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/pile-plan-wasm --target web --out-dir ../../apps/pile-plan-studio/src/core/wasm/pile-plan-wasm && node ../../tools/allow_wasm_package.mjs src/core/wasm/pile-plan-wasm",
    "predev": "npm run build:wasm",
    "dev": "vite --host 127.0.0.1",
    "release:prepare": "node ../../tools/release.mjs prepare",
    "release:check": "node ../../tools/release.mjs check",
    "release:info": "node ../../tools/release.mjs info",
    "release:workflow": "node ../../tools/release.mjs workflow",
    "test:release": "node --test ../../tools/release-*.test.mjs",
    "test": "npm run test:release && npm run release:check && npm run test:unit && npm run test:ui",
    "build": "npm run release:check && npm run build:wasm && npm run release:check && tsc -p tsconfig.json && vite build --config vite.config.ts",
    "tauri": "tauri",
    "test:unit": "node --test src/**/*.test.ts src-primary-entry.test.ts",
    "test:ui": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-store": "^2.4.5",
    "highs": "1.15.3",
    "html2canvas": "^1.4.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
